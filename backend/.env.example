username = shafiqurrehmanbscs2022_db_user
password = 6brzfgyeGb4AihGj
MONGO_URI=

JWT_SECRET=


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=4000


CLIENT_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000

# The one admin account (created on first server start if it doesn't exist)
# The admin is now a normal account with role "admin". This phone number
# is the login identity; the account is created (or promoted) on boot.
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_PASSWORD=

# ── Contact form email (nodemailer) ──────────────────────────────────────
# Where the website contact form delivers. THIS IS THE ONLY VALUE YOU MUST
# FILL IN YOURSELF — set it to the address you want to receive enquiries at.
CONTACT_TO_EMAIL=

# ── Email provider ───────────────────────────────────────────────────────
# The app speaks plain SMTP, so ANY provider below works by changing three
# values. No code change, no lock-in.
#
#
# Gmail: free and needs no domain, but is NOT built for automated mail —
# 500/day cap and confirmations often land in spam. Requires a 16-character
# App Password, never your normal password.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#
# SMTP_FROM must be an address the chosen provider may send as.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Must be an address the SMTP account may send as.
SMTP_FROM="Rohani Ilaj Center" <shafiqurrehmanbscs2022@gmail.com>

# ONE email per customer: the approval notice, and nothing else.
#
# This controls the separate alert to CONTACT_TO_EMAIL when a booking arrives.
# Off, to stay well inside Gmail's ~100/day SMTP cap. The trade-off is that a
# new booking is only visible in the admin dashboard — nothing pings you.
# Set to true if you would rather be told.
NOTIFY_ADMIN_ON_BOOKING=false

# ── Calendly ─────────────────────────────────────────────────────────────
# Needed to resolve WHICH slot a customer booked. The inline widget only posts
# back an event URI, not the date/time, so without these the admin panel's
# Slot column stays empty and no meeting link is auto-filled.
#
# FREE: reading scheduled events works on Calendly's Free plan. Only webhooks
# and three Enterprise-only endpoints need a paid subscription; neither is used.
#
# Get one per account: Calendly > Integrations > API & Webhooks >
# Personal Access Token. Each token only works for its own account, which is
# why the two event types need separate tokens.
CALENDLY_API_TOKEN_CALL=
CALENDLY_API_TOKEN_PHYSICAL=

# ── Post-approval contact ────────────────────────────────────────────────
# Revealed to a customer ONLY after their payment is approved, shown next to
# their confirmed slot.
#
# Deliberately NOT prefixed NEXT_PUBLIC_: anything with that prefix is compiled
# into the JavaScript bundle and readable by everyone, which would defeat the
# point. This is served per-booking by the API and only when status=approved.
SESSION_CONTACT_NUMBER=
