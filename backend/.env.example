# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?appName=Cluster0

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# The one admin account (created on first server start if it doesn't exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Payment screenshot storage ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# ── Contact form email (nodemailer) ──────────────────────────────────────
# Where the website contact form delivers.
CONTACT_TO_EMAIL=you@example.com

# Gmail: host smtp.gmail.com, port 587, user = your full Gmail address, and
# pass = a 16-character App Password from myaccount.google.com/apppasswords
# (a normal Gmail password will NOT work — Google blocks it).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Must be an address the SMTP account may send as.
SMTP_FROM="Rohani Illaj Website" <no-reply@example.com>
