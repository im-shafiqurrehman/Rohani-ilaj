# URL of your backend API (from the backend/ folder)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Your Calendly scheduling page links (Settings > Event Types in Calendly)
NEXT_PUBLIC_CALENDLY_CALL_URL=https://calendly.com/your-handle/30min
NEXT_PUBLIC_CALENDLY_PHYSICAL_URL=https://calendly.com/your-handle/physical-session

# ── Payment ──────────────────────────────────────────────────────────────
# Card is the only payment method the site offers: the customer pays from
# their own debit/credit card into the bank account below, then uploads the
# receipt for manual review. These four values are what the booking page
# shows on the payment step — leave one blank and its row is hidden.
NEXT_PUBLIC_BANK_NAME=YOUR BANK NAME
NEXT_PUBLIC_ACCOUNT_TITLE=ACCOUNT TITLE
NEXT_PUBLIC_ACCOUNT_NUMBER=000000000000
NEXT_PUBLIC_IBAN=PK00XXXX0000000000000000

# ── Contact ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=+920000000000
NEXT_PUBLIC_ADDRESS=Street address, City
NEXT_PUBLIC_EMAIL=you@example.com
# ── Social ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
